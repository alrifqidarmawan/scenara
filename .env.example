# Copy this file to .env.local and fill in the values.
# NEVER prefix SUPABASE_SERVICE_ROLE_KEY or TMDB_API_KEY with NEXT_PUBLIC_ —
# anything public is bundled into the browser (CLAUDE.md §4).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# TMDB → https://www.themoviedb.org/settings/api (v3 API key)
TMDB_API_KEY=

# Google Books → https://console.cloud.google.com (enable "Books API", create an API key).
# Optional: without it, book search uses Open Library only. Free quota is ~1000 requests/day.
GOOGLE_BOOK_API_KEY=
